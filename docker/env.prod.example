# Copie para docker/.env.prod e preencha. Nunca versione o arquivo preenchido.
# Gere a chave com:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=GERE_UMA_CHAVE_LONGA_E_ALEATORIA
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=painel.seudominio.com.br,localhost,127.0.0.1
FRONTEND_URL=https://painel.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://painel.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://painel.seudominio.com.br
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Depois que o HTTPS estiver funcionando, ative o HSTS (ex.: 31536000 = 1 ano).
DJANGO_HSTS_SECONDS=0
GUNICORN_WORKERS=3

# Banco ----------------------------------------------------------------------
# SQLite (padrão): o arquivo fica no volume Docker "rosas-candy_sqlite_data".
DB_ENGINE=sqlite
SQLITE_PATH=/app/data/rosas-candy.db
# PostgreSQL no mesmo servidor: troque DB_ENGINE para postgresql, defina a senha
# e suba com "--profile postgres".
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=doces_mivi
POSTGRES_USER=doces_mivi
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# Assistente com IA (opcional) -----------------------------------------------
# Sem chave, os alertas automáticos continuam funcionando; só o chat fica desligado.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# Portas ---------------------------------------------------------------------
# O Nginx instalado na VPS encaminha o domínio para este endereço.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8085
# API acessível somente dentro da VPS, para diagnóstico.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8087
VITE_API_URL=/api
