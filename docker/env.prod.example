# Copie para docker/.env.prod. Nunca versionar o arquivo preenchido.
# O banco SQLite fica no volume Docker "rosas-candy_sqlite_data".
SQLITE_PATH=/app/data/rosas-candy.db

DJANGO_SECRET_KEY=GERE_UMA_CHAVE_LONGA_E_ALEATORIA
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=painel.seudominio.com,localhost,127.0.0.1
FRONTEND_URL=https://painel.seudominio.com
CORS_ALLOWED_ORIGINS=https://painel.seudominio.com
CSRF_TRUSTED_ORIGINS=https://painel.seudominio.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# O Nginx instalado no host deve encaminhar para este endereco.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8085
# API disponivel somente na propria VPS, para diagnostico.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8087
VITE_API_URL=/api
