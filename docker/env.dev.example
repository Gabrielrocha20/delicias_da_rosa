# Copie para docker/.env.dev.
DJANGO_SECRET_KEY=dev-chave-local-troque-antes-de-compartilhar
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:8085
CORS_ALLOWED_ORIGINS=http://localhost:8085,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8085,http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

DB_ENGINE=sqlite
SQLITE_PATH=/app/data/rosas-candy.db
POSTGRES_PASSWORD=dev-senha-local

ANTHROPIC_API_KEY=

FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8085
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8087
VITE_API_URL=/api
