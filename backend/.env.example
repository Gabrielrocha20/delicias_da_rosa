POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=doces_mivi_dev
POSTGRES_USER=doces_mivi_dev
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60

